{
  "manifest_version": 3,
  "name": "VerseStudio 4K Pro",
  "version": "1.0.0",
  "description": "Studio-grade 4K 60FPS screen-recording with bilingual AI voice and Google Drive cloud sync",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open VerseStudio 4K Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "identity",
    "activeTab",
    "scripting",
    "alarms",
    "tabCapture"
  ],
  "optional_permissions": [
    "desktopCapture"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "studio.html",
        "src/offscreen/offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ]
}
